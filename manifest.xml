<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifiesto del complemento — reescrito en E3.

  Sustituye al heredado, que nunca llegó a funcionar por los tres defectos que
  identificó la auditoría (§5 de FASE1_AUDITORIA_TECNICA.md):

    1. El `ExtensionPoint` de funciones personalizadas estaba dentro de
       `<DesktopFormFactor>`, donde Excel para Windows no lo lee.
    2. Faltaba `<Requirements>`, así que Excel no podía decidir si el
       complemento era compatible antes de cargarlo.
    3. `Functions.Script.Url` apuntaba a un archivo que solo registraba un
       stub, no a las funciones reales.

  **Aquí no se declara ninguna función personalizada todavía**, y es
  deliberado: declarar `RISK.*` apuntando a un `functions.js` que aún no
  existe reproduciría el defecto 3 en otra forma. Las funciones entran cuando
  estén escritas, con su `ExtensionPoint` en `<AllFormFactors>` y sus
  `<Requirements>` de `CustomFunctionsRuntime`. Por ahora, solo el panel.

  El Id es nuevo a propósito: el del heredado puede estar en la caché de
  Office de la máquina del usuario, y reutilizarlo mezclaría los dos
  complementos.
-->
<OfficeApp
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
          xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
          xsi:type="TaskPaneApp">

  <Id>6c55c606-966a-443c-b0af-ad9b854af48f</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>Riesgo Monte Carlo</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Riesgo Monte Carlo" />
  <Description DefaultValue="Análisis de sensibilidad, incertidumbre y riesgo sobre modelos de Excel. Todo el cálculo es local: los datos del libro no salen del equipo." />

  <IconUrl DefaultValue="https://localhost:9090/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:9090/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/danalejo9/riesgo-Montecarlo-excel" />

  <AppDomains>
    <AppDomain>https://localhost:9090</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <!--
    Defecto 2 de la auditoría. Sin esto Excel no sabe qué necesita el
    complemento. ExcelApi 1.1 es el mínimo real del panel de diagnóstico; irá
    subiendo conforme el panel use APIs más nuevas, y ese número es justo lo
    que decide en qué versiones de Excel y de Mac puede instalarse.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:9090/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="Soporte.Url" />
          </GetStarted>

          <FunctionFile resid="Comandos.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="PestanaRiesgo">
              <Group id="GrupoPrincipal">
                <Label resid="GrupoPrincipal.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icono.16" />
                  <bt:Image size="32" resid="Icono.32" />
                  <bt:Image size="80" resid="Icono.80" />
                </Icon>
                <Control xsi:type="Button" id="btnAbrirPanel">
                  <Label resid="btnAbrirPanel.Label" />
                  <Supertip>
                    <Title resid="btnAbrirPanel.Label" />
                    <Description resid="btnAbrirPanel.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icono.16" />
                    <bt:Image size="32" resid="Icono.32" />
                    <bt:Image size="80" resid="Icono.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>PanelRiesgo</TaskpaneId>
                    <SourceLocation resid="Panel.Url" />
                  </Action>
                </Control>
              </Group>
              <Label resid="PestanaRiesgo.Label" />
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icono.16" DefaultValue="https://localhost:9090/icon-16.png" />
        <bt:Image id="Icono.32" DefaultValue="https://localhost:9090/icon-32.png" />
        <bt:Image id="Icono.80" DefaultValue="https://localhost:9090/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Panel.Url" DefaultValue="https://localhost:9090/taskpane.html" />
        <bt:Url id="Comandos.Url" DefaultValue="https://localhost:9090/commands.html" />
        <bt:Url id="Soporte.Url" DefaultValue="https://github.com/danalejo9/riesgo-Montecarlo-excel" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="PestanaRiesgo.Label" DefaultValue="Riesgo" />
        <bt:String id="GrupoPrincipal.Label" DefaultValue="Monte Carlo" />
        <bt:String id="btnAbrirPanel.Label" DefaultValue="Abrir panel" />
        <bt:String id="GetStarted.Title" DefaultValue="Riesgo Monte Carlo" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnAbrirPanel.Tooltip" DefaultValue="Abre el panel de análisis de riesgo." />
        <bt:String id="GetStarted.Description" DefaultValue="Usa la pestaña Riesgo para abrir el panel y analizar tu modelo." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>

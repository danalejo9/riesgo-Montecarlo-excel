<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifiesto del complemento — reescrito en E3.

  Sustituye al heredado, que nunca llegó a funcionar por los tres defectos que
  identificó la auditoría (§5 de FASE1_AUDITORIA_TECNICA.md):

    1. El `ExtensionPoint` de funciones personalizadas estaba dentro de
       `<DesktopFormFactor>`, donde Excel para Windows no lo lee.
    2. Faltaba `<Requirements>`, así que Excel no podía decidir si el
       complemento era compatible antes de cargarlo.
    3. `Functions.Script.Url` apuntaba a un archivo que solo registraba un
       stub, no a las funciones reales.

  **Funciones personalizadas `RIESGO.*`** (desde la versión 0.4): declaradas
  en `<AllFormFactors>`, como pide Excel para Windows, con su script de un
  solo archivo (`funciones.js`) y sus metadatos (`funciones.json`, generados
  del catálogo del motor). Ver `engine/modelo/funcionesRiesgo.ts`.

  **Runtime compartido** (desde la versión 0.5, etapa 2, B1): el panel, los
  botones de la cinta y las funciones `RIESGO.*` viven en **un solo proceso**,
  la página `taskpane.html`, que carga también `funciones.js`. Así:
    - las funciones leen los resultados del panel en memoria (B6) y, más
      adelante, sabrán en qué iteración está una simulación (B1b);
    - los botones de la cinta ejecutan una acción (`ExecuteFunction`) que
      cambia de pestaña y muestra el panel **sin recargarlo** (antes se
      recargaba y se veía un instante en blanco, prueba B4 del 29/09).
  Exige el conjunto `SharedRuntime 1.1` (Microsoft 365 en Windows, Mac y la
  Web): en un Excel que no lo tenga, el complemento no se instala.

  El Id es nuevo a propósito: el del heredado puede estar en la caché de
  Office de la máquina del usuario, y reutilizarlo mezclaría los dos
  complementos.
-->
<OfficeApp
          xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
          xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
          xsi:type="TaskPaneApp">

  <Id>6c55c606-966a-443c-b0af-ad9b854af48f</Id>
  <Version>0.5.0.0</Version>
  <ProviderName>Riesgo Monte Carlo</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="Riesgo Monte Carlo" />
  <Description DefaultValue="Análisis de sensibilidad, incertidumbre y riesgo sobre modelos de Excel. Todo el cálculo es local: los datos del libro no salen del equipo." />

  <IconUrl DefaultValue="https://localhost:9090/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:9090/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/danalejo9/riesgo-Montecarlo-excel" />

  <AppDomains>
    <AppDomain>https://localhost:9090</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Workbook" />
  </Hosts>

  <!--
    Defecto 2 de la auditoría. Sin esto Excel no sabe qué necesita el
    complemento. ExcelApi 1.1 es el mínimo real del panel de diagnóstico; irá
    subiendo conforme el panel use APIs más nuevas, y ese número es justo lo
    que decide en qué versiones de Excel y de Mac puede instalarse.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1" />
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:9090/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <!-- B1: un solo proceso para panel, cinta y funciones (ver arriba). -->
        <Runtimes>
          <Runtime resid="Panel.Url" lifetime="long" />
        </Runtimes>
        <AllFormFactors>
          <ExtensionPoint xsi:type="CustomFunctions">
            <Script>
              <SourceLocation resid="Funciones.Script.Url" />
            </Script>
            <Page>
              <SourceLocation resid="Panel.Url" />
            </Page>
            <Metadata>
              <SourceLocation resid="Funciones.Metadata.Url" />
            </Metadata>
            <Namespace resid="Funciones.Namespace" />
          </ExtensionPoint>
        </AllFormFactors>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="Soporte.Url" />
          </GetStarted>

          <FunctionFile resid="Panel.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="PestanaRiesgo">
              <Group id="GrupoPrincipal">
                <Label resid="GrupoPrincipal.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icono.16" />
                  <bt:Image size="32" resid="Icono.32" />
                  <bt:Image size="80" resid="Icono.80" />
                </Icon>
                <!--
                  Cuatro botones, un solo panel. Cada uno ejecuta una acción
                  del runtime compartido (`mostrarModelo`, `mostrarResultados`…,
                  registradas en `ui/acciones.ts`) que pone la pestaña y
                  muestra el panel con `Office.addin.showAsTaskpane()`, sin
                  recargarlo ni perder los resultados.
                -->
                <Control xsi:type="Button" id="btnModelo">
                  <Label resid="btnModelo.Label" />
                  <Supertip>
                    <Title resid="btnModelo.Label" />
                    <Description resid="btnModelo.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconoModelo.16" />
                    <bt:Image size="32" resid="IconoModelo.32" />
                    <bt:Image size="80" resid="IconoModelo.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>mostrarModelo</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="btnResultados">
                  <Label resid="btnResultados.Label" />
                  <Supertip>
                    <Title resid="btnResultados.Label" />
                    <Description resid="btnResultados.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconoResultados.16" />
                    <bt:Image size="32" resid="IconoResultados.32" />
                    <bt:Image size="80" resid="IconoResultados.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>mostrarResultados</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="btnConfiguracion">
                  <Label resid="btnConfiguracion.Label" />
                  <Supertip>
                    <Title resid="btnConfiguracion.Label" />
                    <Description resid="btnConfiguracion.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconoConfiguracion.16" />
                    <bt:Image size="32" resid="IconoConfiguracion.32" />
                    <bt:Image size="80" resid="IconoConfiguracion.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>mostrarConfiguracion</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="btnDiagnostico">
                  <Label resid="btnDiagnostico.Label" />
                  <Supertip>
                    <Title resid="btnDiagnostico.Label" />
                    <Description resid="btnDiagnostico.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icono.16" />
                    <bt:Image size="32" resid="Icono.32" />
                    <bt:Image size="80" resid="Icono.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>mostrarDiagnostico</FunctionName>
                  </Action>
                </Control>
              </Group>
              <!--
                B2: el modo del libro. Qué enseñan las celdas RIESGO fuera de
                la simulación: un valor fijo (la media, u otro elegido en
                Configuración) o uno al azar que cambia con F9. El botón del
                modo activo queda desactivado (Office.ribbon.requestUpdate).
              -->
              <Group id="GrupoModo">
                <Label resid="GrupoModo.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icono.16" />
                  <bt:Image size="32" resid="Icono.32" />
                  <bt:Image size="80" resid="Icono.80" />
                </Icon>
                <Control xsi:type="Button" id="btnFijo">
                  <Label resid="btnFijo.Label" />
                  <Supertip>
                    <Title resid="btnFijo.Label" />
                    <Description resid="btnFijo.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconoFijo.16" />
                    <bt:Image size="32" resid="IconoFijo.32" />
                    <bt:Image size="80" resid="IconoFijo.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>modoFijo</FunctionName>
                  </Action>
                  <Enabled>false</Enabled>
                </Control>
                <Control xsi:type="Button" id="btnAleatorio">
                  <Label resid="btnAleatorio.Label" />
                  <Supertip>
                    <Title resid="btnAleatorio.Label" />
                    <Description resid="btnAleatorio.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="IconoAleatorio.16" />
                    <bt:Image size="32" resid="IconoAleatorio.32" />
                    <bt:Image size="80" resid="IconoAleatorio.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>modoAleatorio</FunctionName>
                  </Action>
                </Control>
              </Group>
              <Label resid="PestanaRiesgo.Label" />
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icono.16" DefaultValue="https://localhost:9090/icon-16.png" />
        <bt:Image id="Icono.32" DefaultValue="https://localhost:9090/icon-32.png" />
        <bt:Image id="Icono.80" DefaultValue="https://localhost:9090/icon-80.png" />
        <bt:Image id="IconoModelo.16" DefaultValue="https://localhost:9090/icon-config-16.png" />
        <bt:Image id="IconoModelo.32" DefaultValue="https://localhost:9090/icon-config-32.png" />
        <bt:Image id="IconoModelo.80" DefaultValue="https://localhost:9090/icon-config-80.png" />
        <bt:Image id="IconoResultados.16" DefaultValue="https://localhost:9090/icon-results-16.png" />
        <bt:Image id="IconoResultados.32" DefaultValue="https://localhost:9090/icon-results-32.png" />
        <bt:Image id="IconoResultados.80" DefaultValue="https://localhost:9090/icon-results-80.png" />
        <bt:Image id="IconoConfiguracion.16" DefaultValue="https://localhost:9090/icon-settings-16.png" />
        <bt:Image id="IconoConfiguracion.32" DefaultValue="https://localhost:9090/icon-settings-32.png" />
        <bt:Image id="IconoConfiguracion.80" DefaultValue="https://localhost:9090/icon-settings-80.png" />
        <bt:Image id="IconoFijo.16" DefaultValue="https://localhost:9090/icon-config-16.png" />
        <bt:Image id="IconoFijo.32" DefaultValue="https://localhost:9090/icon-config-32.png" />
        <bt:Image id="IconoFijo.80" DefaultValue="https://localhost:9090/icon-config-80.png" />
        <bt:Image id="IconoAleatorio.16" DefaultValue="https://localhost:9090/icon-simulate-16.png" />
        <bt:Image id="IconoAleatorio.32" DefaultValue="https://localhost:9090/icon-simulate-32.png" />
        <bt:Image id="IconoAleatorio.80" DefaultValue="https://localhost:9090/icon-simulate-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Panel.Url" DefaultValue="https://localhost:9090/taskpane.html" />
        <bt:Url id="Funciones.Script.Url" DefaultValue="https://localhost:9090/funciones.js" />
        <bt:Url id="Funciones.Metadata.Url" DefaultValue="https://localhost:9090/funciones.json" />
        <bt:Url id="Soporte.Url" DefaultValue="https://github.com/danalejo9/riesgo-Montecarlo-excel" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="PestanaRiesgo.Label" DefaultValue="Riesgo" />
        <bt:String id="Funciones.Namespace" DefaultValue="RIESGO" />
        <bt:String id="GrupoPrincipal.Label" DefaultValue="Monte Carlo" />
        <bt:String id="btnModelo.Label" DefaultValue="Modelo" />
        <bt:String id="btnResultados.Label" DefaultValue="Resultados" />
        <bt:String id="btnConfiguracion.Label" DefaultValue="Configuración" />
        <bt:String id="btnDiagnostico.Label" DefaultValue="Diagnóstico" />
        <bt:String id="GrupoModo.Label" DefaultValue="Modo del libro" />
        <bt:String id="btnFijo.Label" DefaultValue="Valores fijos" />
        <bt:String id="btnAleatorio.Label" DefaultValue="Aleatorio" />
        <bt:String id="GetStarted.Title" DefaultValue="Riesgo Monte Carlo" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="btnModelo.Tooltip" DefaultValue="Entradas inciertas, salidas y ajustes de la simulación. Desde aquí se simula." />
        <bt:String id="btnResultados.Tooltip" DefaultValue="Resultados de la última simulación: probabilidades, histograma, curva acumulada y sensibilidad." />
        <bt:String id="btnConfiguracion.Tooltip" DefaultValue="Iteraciones, semilla, muestreo, motor, precisión objetivo y núcleos del equipo." />
        <bt:String id="btnFijo.Tooltip" DefaultValue="Las celdas con funciones RIESGO enseñan un valor fijo: la media, o la mediana, la moda o un percentil (se elige en Configuración)." />
        <bt:String id="btnAleatorio.Tooltip" DefaultValue="Las celdas con funciones RIESGO enseñan un valor al azar; F9 vuelve a sortear. No cambia los resultados de la simulación." />
        <bt:String id="btnDiagnostico.Tooltip" DefaultValue="Estado del complemento, lo guardado en el libro y la configuración regional." />
        <bt:String id="GetStarted.Description" DefaultValue="Usa la pestaña Riesgo para abrir el panel y analizar tu modelo." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
